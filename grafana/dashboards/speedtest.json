{
  "uid": "speedtest",
  "title": "Internet Speedtest",
  "description": "Official Ookla CLI measurements. Tests start randomly every 5-60 minutes; repeated samples between tests are the most recent result. Check data age and next-test countdown for stale data.",
  "tags": ["network", "speedtest"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Download", "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_download_bits_per_second", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "bps", "decimals": 2}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 2, "title": "Upload", "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_upload_bits_per_second", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "bps", "decimals": 2}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 3, "title": "Idle latency", "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_ping_latency_seconds", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 2}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 4, "title": "Idle jitter", "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_ping_jitter_seconds", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 2}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 5, "title": "Packet loss", "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_packet_loss_percent", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 6, "title": "Latest test status", "type": "stat",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_success", "instant": true}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "FAILED", "color": "red"}, "1": {"text": "OK", "color": "green"}}}]}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"}
    },
    {
      "id": 7, "title": "Last successful result age", "type": "stat",
      "description": "Retained measurements can be stale even when the last test succeeded.",
      "gridPos": {"x": 0, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "time() - speedtest_last_success_timestamp_seconds", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 3900}, {"color": "red", "value": 7200}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none"}
    },
    {
      "id": 8, "title": "Next test in (negative = overdue)", "type": "stat",
      "gridPos": {"x": 4, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_next_run_timestamp_seconds - time()", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": -210}, {"color": "green", "value": 0}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"}
    },
    {
      "id": 9, "title": "Last test wall time", "type": "stat",
      "gridPos": {"x": 8, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_run_duration_seconds", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"}
    },
    {
      "id": 10, "title": "Attempts (runner lifetime)", "type": "stat",
      "gridPos": {"x": 12, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_attempts_total", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"}
    },
    {
      "id": 11, "title": "Failures (runner lifetime)", "type": "stat",
      "gridPos": {"x": 16, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_failures_total", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"}
    },
    {
      "id": 12, "title": "Selected start-to-start interval", "type": "stat",
      "gridPos": {"x": 20, "y": 4, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_interval_seconds", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none"}
    },
    {
      "id": 13, "title": "Download and upload throughput", "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "speedtest_download_bits_per_second", "legendFormat": "Download"},
        {"refId": "B", "expr": "speedtest_upload_bits_per_second", "legendFormat": "Upload"}
      ],
      "fieldConfig": {"defaults": {"unit": "bps", "min": 0, "custom": {"lineInterpolation": "stepAfter", "fillOpacity": 10}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 14, "title": "Idle latency and jitter", "type": "timeseries",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "speedtest_ping_latency_seconds", "legendFormat": "Idle latency"},
        {"refId": "B", "expr": "speedtest_ping_jitter_seconds", "legendFormat": "Idle jitter"},
        {"refId": "C", "expr": "speedtest_ping_low_seconds", "legendFormat": "Minimum idle latency"},
        {"refId": "D", "expr": "speedtest_ping_high_seconds", "legendFormat": "Maximum idle latency"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 15, "title": "Loaded download / upload latency (IQM, low, high)", "type": "timeseries",
      "description": "IQM is Ookla's interquartile mean. These optional values describe latency during saturated transfers.",
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "speedtest_download_latency_iqm_seconds", "legendFormat": "Download latency (IQM)"},
        {"refId": "B", "expr": "speedtest_download_latency_low_seconds", "legendFormat": "Minimum download latency"},
        {"refId": "C", "expr": "speedtest_download_latency_high_seconds", "legendFormat": "Maximum download latency"},
        {"refId": "D", "expr": "speedtest_upload_latency_iqm_seconds", "legendFormat": "Upload latency (IQM)"},
        {"refId": "E", "expr": "speedtest_upload_latency_low_seconds", "legendFormat": "Minimum upload latency"},
        {"refId": "F", "expr": "speedtest_upload_latency_high_seconds", "legendFormat": "Maximum upload latency"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 16, "title": "Loaded download / upload jitter", "type": "timeseries",
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "speedtest_download_latency_jitter_seconds", "legendFormat": "Download jitter"},
        {"refId": "B", "expr": "speedtest_upload_latency_jitter_seconds", "legendFormat": "Upload jitter"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 17, "title": "Packet loss history", "type": "timeseries",
      "gridPos": {"x": 0, "y": 24, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_packet_loss_percent", "legendFormat": "Packet loss"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 18, "title": "Bytes transferred per test (not cumulative)", "type": "timeseries",
      "gridPos": {"x": 8, "y": 24, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "speedtest_download_bytes", "legendFormat": "Download"},
        {"refId": "B", "expr": "speedtest_upload_bytes", "legendFormat": "Upload"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "custom": {"lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 19, "title": "Test durations", "type": "timeseries",
      "gridPos": {"x": 16, "y": 24, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "speedtest_download_duration_seconds", "legendFormat": "Download phase"},
        {"refId": "B", "expr": "speedtest_upload_duration_seconds", "legendFormat": "Upload phase"},
        {"refId": "C", "expr": "speedtest_run_duration_seconds", "legendFormat": "Whole test"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 20, "title": "Last attempt / last success", "type": "stat",
      "gridPos": {"x": 0, "y": 32, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "speedtest_last_attempt_timestamp_seconds * 1000", "legendFormat": "Last attempt", "instant": true},
        {"refId": "B", "expr": "speedtest_last_success_timestamp_seconds * 1000", "legendFormat": "Last success", "instant": true}
      ],
      "fieldConfig": {"defaults": {"unit": "dateTimeAsIso"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "graphMode": "none", "textMode": "value_and_name"}
    },
    {
      "id": 21, "title": "Test success and Pushgateway availability", "type": "timeseries",
      "gridPos": {"x": 12, "y": 32, "w": 12, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "speedtest_success", "legendFormat": "Latest test success"},
        {"refId": "B", "expr": "up{job=\"pushgateway\"}", "legendFormat": "Pushgateway reachable"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "custom": {"lineInterpolation": "stepAfter"}}, "overrides": []},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 22, "title": "Latest successful test server and ISP", "type": "table",
      "gridPos": {"x": 0, "y": 36, "w": 24, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "speedtest_info", "format": "table", "instant": true}],
      "transformations": [{"id": "organize", "options": {
        "excludeByName": {"Time": true, "Value": true, "__name__": true, "job": true, "instance": true},
        "renameByName": {"isp": "ISP", "server_id": "Server ID", "server_name": "Server", "server_location": "Location", "server_country": "Country"}
      }}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    }
  ]
}
